# Local development: copy to server/.env (git-ignored). Production values live in deploy/.env.
MAATA_ENV=development
MAATA_GNANI_API_KEY=
# Optional: a separate key for Timbre TTS (otherwise MAATA_GNANI_API_KEY is used for both)
MAATA_GNANI_TTS_API_KEY=
MAATA_REDIS_URL=redis://localhost:6379/0
MAATA_DATABASE_URL=postgresql://maata:maata@localhost:5432/maata
MAATA_AUDIO_CACHE_DIR=./data/audio
MAATA_ALLOWED_ORIGINS=http://localhost:5173
MAATA_PUBLIC_ORIGIN=http://localhost:5173
# Cloudflare's always-pass test secret; pair with site key 1x00000000000000000000AA in the client.
MAATA_TURNSTILE_SECRET=1x0000000000000000000000000000000AA
MAATA_DAILY_CREDIT_BUDGET=50
