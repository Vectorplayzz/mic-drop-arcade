  "story": {
    "wizard": "Taara",
    "intro": "मैं जादूगर तारा हूँ। मेरा जादुई तारा खो गया है। हर सही जवाब हमें उसके पास ले जाएगा!",
    "chapters": [
      "शाबाश! पहला दरवाज़ा खुल गया।",
