# Copy to deploy/.env on the VPS (chmod 600, owned by the deploy user). Never commit .env.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Gnani ---------------------------------------------------------------------------
MAATA_GNANI_API_KEY=          # Prisma STT (and Timbre TTS unless the next one is set)
MAATA_GNANI_TTS_API_KEY=      # optional: Timbre TTS with its own key

# --- Secrets (>= 32 chars each) -------------------------------------------------------
MAATA_JWT_SECRET=
MAATA_IP_HASH_SECRET=
REDIS_PASSWORD=
POSTGRES_PASSWORD=

# --- Cloudflare Turnstile (widget must be rendered with action="start") ----------------
MAATA_TURNSTILE_SECRET=
MAATA_TURNSTILE_HOSTNAME=maata.ourspaces.net

# --- Public surface ---------------------------------------------------------------------
MAATA_PUBLIC_ORIGIN=https://maata.ourspaces.net
MAATA_ALLOWED_ORIGINS=https://maata.ourspaces.net

# --- Credit budget (set the per-unit rates once Gnani confirms them on Discord) ---------
MAATA_CREDITS_TOTAL=5000
MAATA_DAILY_CREDIT_BUDGET=300
MAATA_CREDITS_PER_STT_MINUTE=1.0
MAATA_CREDITS_PER_1K_TTS_CHARS=1.0
# Discord webhook for 50% / 80% / 100% alerts (optional but recommended)
MAATA_ALERT_WEBHOOK_URL=
# Hard stop without touching Redis: set to true and restart the api container.
MAATA_KILL_SWITCH=false

# --- Limits (defaults shown) -----------------------------------------------------------
# MAATA_MAX_CONCURRENT_GAMES=60
# MAATA_MAX_AUDIO_S_PER_SESSION=240
# MAATA_MAX_AUDIO_S_PER_IP_DAY=900
# MAATA_ANSWER_TIME_LIMIT_S=12
