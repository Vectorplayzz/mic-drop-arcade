{
  "name": "maata-arcade-client",
  "version": "1.0.0",
  "private": true,
  "description": "Maata Arcade game client: a retro, voice-only quiz PWA",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:mock": "vite preview --mode mock",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:dist": "node scripts/check-dist.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "5.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "ws": "8.22.0"
  }
}
